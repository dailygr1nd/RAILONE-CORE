@@ -0,0 +1,229 @@
+"""Receiver-first bilateral authority for P2P sandbox execution, version 2.
+
+The receiver signs the immutable quote commitment BEFORE the sender signs.
+The UTT is created only after both verified artifacts are available. No UTT
+identifier is included in either pre-UTT authority (avoids circular signing).
+"""
+
+from __future__ import annotations
+
+import hashlib
+from datetime import datetime
+from typing import Mapping, Any
+
+from railone_crypto.canonical_json import canonical_json_bytes
+from railone_crypto.signature_service import ArtifactType, SignatureEnvelope, SignatureService
+
+
+def _sha(value: Mapping[str, Any]) -> str:
+    return hashlib.sha256(canonical_json_bytes(value)).hexdigest()
+
+
+def _id(prefix: str, value: Mapping[str, Any]) -> str:
+    return prefix + "-" + _sha(value)[:32].upper()
+
+
+def _instant(at: datetime) -> int:
+    if at.tzinfo is None:
+        raise ValueError("authority time must be timezone-aware")
+    return int(at.timestamp())
+
+
+def _verified(signatures: SignatureService, envelope: SignatureEnvelope, kind: ArtifactType, owner: str) -> Mapping[str, Any]:
+    check = signatures.verify_artifact(envelope, expected_artifact_type=kind)
+    if not check.valid:
+        raise PermissionError("BILATERAL_SIGNATURE_INVALID:" + check.reason)
+    if envelope.protected.get("iss") != owner:
+        raise PermissionError("BILATERAL_SIGNER_OWNER_MISMATCH")
+    return envelope.payload
+
+
+def quote_commitment(quote: Mapping[str, Any]) -> dict[str, Any]:
+    """Bind all quote terms, not merely the amount or visible account aliases."""
+    return {
+        "quote_id": quote["quote_id"],
+        "quote_payload_sha256": quote.get("quote_payload_sha256") or _sha(quote),
+        "payer_actor_id": quote["payer"]["actor_id"],
+        "payer_actor_type": quote["payer"]["actor_type"],
+        "beneficiary_actor_id": quote["beneficiary"]["actor_id"],
+        "beneficiary_actor_type": quote["beneficiary"]["actor_type"],
+        "payer_binding_sha256": _sha(quote["payer"]["endpoint"]),
+        "beneficiary_binding_sha256": _sha(quote["beneficiary"]["endpoint"]),
+        "amount_minor": quote["amount_minor"],
+        "currency_from": quote["currency_from"],
+        "receive_amount_minor": quote["receive_amount_minor"],
+        "currency_to": quote["currency_to"],
+    }
+
+
+class BilateralAuthorityService:
+    """Sandbox signing helper and trusted verifier.
+
+    Production receivers/senders sign outside RailOne. The issuance methods
+    assume an authenticated caller; signature ownership is enforced at verify.
+    """
+
+    MAX_TTL_SECONDS = 900
+
+    def __init__(self, signatures: SignatureService) -> None:
+        self._signatures = signatures
+
+    def issue_receiver_acceptance(
+        self, *, signed_quote: SignatureEnvelope, signing_key_id: str,
+        accepted_at: datetime, expires_at: datetime,
+    ) -> SignatureEnvelope:
+        epoch, expiry = _instant(accepted_at), _instant(expires_at)
+        if not epoch < expiry <= epoch + self.MAX_TTL_SECONDS:
+            raise ValueError("invalid receiver authority window")
+        result = self._signatures.verify_artifact(signed_quote, expected_artifact_type=ArtifactType.QUOTE)
+        if not result.valid:
+            raise PermissionError("QUOTE_INVALID:" + result.reason)
+        quote = signed_quote.payload
+        if not quote["issued_at"] <= epoch < quote["expires_at"]:
+            raise PermissionError("QUOTE_NOT_ACTIVE")
+        if quote["purpose"] != "PERSON_TO_PERSON":
+            raise PermissionError("RECEIVER_FIRST_FLOW_P2P_ONLY")
+        core = {
+            "authority_version": 2,
+            "authorization_scope": "ACCEPT_QUOTE",
+            "receiver_confirmed": True,
+            "participation_mode": "ACTIVE_ACCEPTANCE",
+            **quote_commitment(quote),
+            "accepted_at": epoch,
+            "expires_at": expiry,
+            "status": "ACTIVE",
+            "custody_model": "NON_CUSTODIAL",
+        }
+        signed = self._signatures.sign_artifact(
+            artifact_type=ArtifactType.ETK_R,
+            payload={"etk_r_id": _id("ETKR", core), **core},
+            key_id=signing_key_id, issued_at=accepted_at,
+        )
+        _verified(self._signatures, signed, ArtifactType.ETK_R, quote["beneficiary"]["actor_id"])
+        return signed
+
+    def verify_receiver(
+        self, *, signed_quote: SignatureEnvelope, receiver: SignatureEnvelope,
+        at: datetime,
+    ) -> None:
+        epoch = _instant(at)
+        result = self._signatures.verify_artifact(signed_quote, expected_artifact_type=ArtifactType.QUOTE)
+        if not result.valid:
+            raise PermissionError("QUOTE_INVALID:" + result.reason)
+        quote = signed_quote.payload
+        payload = _verified(self._signatures, receiver, ArtifactType.ETK_R, quote["beneficiary"]["actor_id"])
+        expected = quote_commitment(quote)
+        if payload.get("authority_version") != 2 or payload.get("authorization_scope") != "ACCEPT_QUOTE" or payload.get("participation_mode") != "ACTIVE_ACCEPTANCE" or payload.get("receiver_confirmed") is not True or payload.get("status") != "ACTIVE" or payload.get("custody_model") != "NON_CUSTODIAL":
+            raise PermissionError("RECEIVER_AUTHORITY_SCOPE_INVALID")
+        if any(payload.get(k) != v for k, v in expected.items()):
+            raise PermissionError("RECEIVER_QUOTE_BINDING_MISMATCH")
+        if (payload.get("etk_r_id") != _id("ETKR", {k:v for k,v in payload.items() if k != "etk_r_id"})
+                or not isinstance(payload.get("accepted_at"), int)
+                or not isinstance(payload.get("expires_at"), int)
+                or not payload["accepted_at"] <= epoch < payload["expires_at"]
+                or not payload["accepted_at"] < payload["expires_at"] <= payload["accepted_at"] + self.MAX_TTL_SECONDS
+                or payload["accepted_at"] < quote["issued_at"]
+                or payload["accepted_at"] >= quote["expires_at"]
+                or receiver.protected["iat"] != payload["accepted_at"]):
+            raise PermissionError("RECEIVER_AUTHORITY_NOT_ACTIVE")
+
+    def issue_sender_authority(
+        self, *, signed_quote: SignatureEnvelope, receiver: SignatureEnvelope,
+        signing_key_id: str, authorized_at: datetime, expires_at: datetime,
+    ) -> SignatureEnvelope:
+        self.verify_receiver(signed_quote=signed_quote, receiver=receiver, at=authorized_at)
+        epoch, expiry = _instant(authorized_at), _instant(expires_at)
+        if not epoch < expiry <= epoch + self.MAX_TTL_SECONDS or expiry > receiver.payload["expires_at"]:
+            raise ValueError("invalid sender authority window")
+        if not signed_quote.payload["issued_at"] <= epoch < signed_quote.payload["expires_at"]:
+            raise PermissionError("QUOTE_NOT_ACTIVE")
+        core = {
+            "authority_version": 2,
+            "authorization_scope": "AUTHORIZE_BILATERAL_QUOTE",
+            **quote_commitment(signed_quote.payload),
+            "etk_r_id": receiver.payload["etk_r_id"],
+            "etk_r_digest": receiver.protected["payload_sha256"],
+            "authorized_at": epoch,
+            "expires_at": expiry,
+            "status": "ACTIVE",
+            "custody_model": "NON_CUSTODIAL",
+        }
+        signed = self._signatures.sign_artifact(
+            artifact_type=ArtifactType.ETK_S,
+            payload={"etk_s_id": _id("ETKS", core), **core},
+            key_id=signing_key_id, issued_at=authorized_at,
+        )
+        _verified(self._signatures, signed, ArtifactType.ETK_S, signed_quote.payload["payer"]["actor_id"])
+        return signed
+
+    def verify_sender(
+        self, *, signed_quote: SignatureEnvelope,
+        receiver: SignatureEnvelope, sender: SignatureEnvelope, at: datetime,
+    ) -> None:
+        """Verify an independently signed ETK-S before any UTT is issued."""
+        epoch = _instant(at)
+        self.verify_receiver(signed_quote=signed_quote, receiver=receiver, at=at)
+        quote = signed_quote.payload
+        s = _verified(self._signatures, sender, ArtifactType.ETK_S,
+                      quote["payer"]["actor_id"])
+        expected = quote_commitment(quote)
+        if any(s.get(k) != v for k, v in expected.items()):
+            raise PermissionError("SENDER_QUOTE_BINDING_MISMATCH")
+        if (s.get("authority_version") != 2 or
+                s.get("authorization_scope") != "AUTHORIZE_BILATERAL_QUOTE" or
+                s.get("status") != "ACTIVE" or
+                s.get("custody_model") != "NON_CUSTODIAL" or
+                s.get("etk_r_id") != receiver.payload["etk_r_id"] or
+                s.get("etk_r_digest") != receiver.protected["payload_sha256"] or
+                s.get("etk_s_id") != _id("ETKS", {k:v for k,v in s.items() if k != "etk_s_id"})):
+            raise PermissionError("BILATERAL_CHAIN_BROKEN")
+        issued, expiry = s.get("authorized_at"), s.get("expires_at")
+        if not (type(issued) is int and type(expiry) is int and
+                receiver.payload["accepted_at"] <= issued <= epoch < expiry <= receiver.payload["expires_at"] and
+                issued < expiry <= issued + self.MAX_TTL_SECONDS and
+                signed_quote.payload["issued_at"] <= issued < signed_quote.payload["expires_at"] and
+                sender.protected["iat"] == issued):
+            raise PermissionError("BILATERAL_AUTHORITY_EXPIRED_OR_REORDERED")
+
+    def verify_utt(
+        self, *, signed_utt: SignatureEnvelope, sender: SignatureEnvelope,
+        receiver: SignatureEnvelope, at: datetime,
+    ) -> None:
+        epoch = _instant(at)
+        verification = self._signatures.verify_artifact(signed_utt, expected_artifact_type=ArtifactType.UTT)
+        if not verification.valid:
+            raise PermissionError("UTT_INVALID:" + verification.reason)
+        utt = signed_utt.payload
+        if utt.get("authority_version") != 2 or utt["origin"].get("context_type") != "P2P":
+            raise PermissionError("BILATERAL_UTT_REQUIRED")
+        s = _verified(self._signatures, sender, ArtifactType.ETK_S, utt["payer"]["actor_id"])
+        r = _verified(self._signatures, receiver, ArtifactType.ETK_R, utt["beneficiary"]["actor_id"])
+        expected = quote_commitment(utt)
+        if any(s.get(k) != v or r.get(k) != v for k, v in expected.items()):
+            raise PermissionError("BILATERAL_QUOTE_BINDING_MISMATCH")
+        if (s.get("authority_version") != 2 or r.get("authority_version") != 2
+                or s.get("authorization_scope") != "AUTHORIZE_BILATERAL_QUOTE"
+                or r.get("authorization_scope") != "ACCEPT_QUOTE"
+                or r.get("receiver_confirmed") is not True
+                or s.get("status") != "ACTIVE" or r.get("status") != "ACTIVE"
+                or s.get("custody_model") != "NON_CUSTODIAL" or r.get("custody_model") != "NON_CUSTODIAL"
+                or s.get("etk_r_id") != r.get("etk_r_id")
+                or s.get("etk_r_digest") != receiver.protected["payload_sha256"]
+                or utt.get("etk_s_id") != s.get("etk_s_id")
+                or utt.get("etk_r_id") != r.get("etk_r_id")
+                or utt.get("etk_s_digest") != sender.protected["payload_sha256"]
+                or utt.get("etk_r_digest") != receiver.protected["payload_sha256"]):
+            raise PermissionError("BILATERAL_CHAIN_BROKEN")
+        if not (isinstance(r.get("accepted_at"), int) and isinstance(s.get("authorized_at"), int)
+                and isinstance(s.get("expires_at"), int) and isinstance(r.get("expires_at"), int)
+                and r["accepted_at"] <= s["authorized_at"] <= utt["accepted_at"] <= epoch
+                < s["expires_at"] <= r["expires_at"]
+                and r["accepted_at"] < r["expires_at"] <= r["accepted_at"] + self.MAX_TTL_SECONDS
+                and s["authorized_at"] < s["expires_at"] <= s["authorized_at"] + self.MAX_TTL_SECONDS
+                and receiver.protected["iat"] == r["accepted_at"]
+                and sender.protected["iat"] == s["authorized_at"]):
+            raise PermissionError("BILATERAL_AUTHORITY_EXPIRED_OR_REORDERED")
+        # Validates deterministic IDs; makes a forged but validly signed mismatch explicit.
+        if (r["etk_r_id"] != _id("ETKR", {k:v for k,v in r.items() if k != "etk_r_id"})
+                or s["etk_s_id"] != _id("ETKS", {k:v for k,v in s.items() if k != "etk_s_id"})):
+            raise PermissionError("BILATERAL_AUTHORITY_ID_MISMATCH")
