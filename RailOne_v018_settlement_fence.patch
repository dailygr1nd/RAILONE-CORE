+            (instant, rtt_id),
+        )
+        if cursor.rowcount != 1:
+            raise EconomicFenceViolation("cannot finalize RTT operational fence")
+        PostgresEconomicEffectFence._event(cursor, utt_id, rtt_id, row["fence_epoch"],
+                    "SETTLED", evidence_id, instant)
 
